# Copy to .env and fill in. Never commit .env.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's Webhooks section (developer dashboard).
PAYPAL_WEBHOOK_ID=
DATABASE_URL=postgres://standing:standing@localhost:5432/standing
# Shared secret the scheduler sends as `Authorization: Bearer …` to POST /api/cron/run.
CRON_SECRET=
STANDING_SELLER_ID=sandbox-seller
# Policy check and pack plans: Groq first, Gemini as fallback (and for invoice images). Models are optional overrides.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per-request LLM timeout (ms); Gemini 3.8 Flash can take 90 s+ on hard products.
LLM_TIMEOUT_MS=150000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Log in with PayPal. Register <APP_BASE_URL>/api/auth/paypal/callback as a return URL in the sandbox app.
APP_BASE_URL=http://localhost:3000
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Comma-separated PayPal payer IDs allowed to open a session. Required in production: if it is empty there,
# every login is refused. Optional in development.
STANDING_ALLOWED_PAYER_IDS=

# Email alerts (optional; off unless both are set). New alerts are emailed once, in the dashboard's words.
# Resend's free plan sends from onboarding@resend.dev to the address you signed up with.
STANDING_ALERT_EMAIL=
RESEND_API_KEY=
# STANDING_EMAIL_FROM="Standing <alerts@your-domain>"   # only once a domain is verified in Resend

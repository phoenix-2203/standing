{
  "name": "standing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:live": "vitest run --config vitest.live.config.mts",
    "eval:policy": "node --env-file=.env --import tsx src/evals/run-policy-eval.ts",
    "eval:rescore": "node --import tsx src/evals/rescore-policy-eval.ts",
    "eval:refusal": "node --env-file=.env --import tsx src/evals/run-refusal-eval.ts",
    "cycle": "node --env-file=.env --import tsx src/jobs/run-cycle.ts",
    "demo:orders": "node --env-file=.env --import tsx src/jobs/demo-orders.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.553.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
